MODEL_PROVIDER=gemini
GOOGLE_AI_STUDIO_API_KEY=your-api-key
GOOGLE_CLOUD_PROJECT=your-billing-project
# Required for the Gemini provider. Use a Google AI Studio model with a configured token tariff.
GEMINI_MODEL=gemini-3.5-flash-lite
# Match the billing tier of the Google API key (standard or free).
GEMINI_BILLING_TIER=standard
# Set MODEL_PROVIDER=openrouter to use the OpenAI-compatible Chat Completions client.
# Only the selected provider's API key is required. The model must support tool calling and structured JSON output.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
BIGQUERY_DATASET=bigquery-public-data.thelook_ecommerce
MAX_MODEL_CALLS=12
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
USERS_FILE=config/users.json
DEFAULT_USER=manager_a
DATA_DIR=.retail-agent
STARTUP_TIMEOUT_SECONDS=15
REQUEST_BUDGET_USD=1
QUESTION_TIMEOUT_SECONDS=30
REPORT_TIMEOUT_SECONDS=120
MAX_OUTPUT_TOKENS=2048
MAX_SQL_ATTEMPTS=4
MAX_RESULT_ROWS=50
HISTORY_MAX_TURNS=6
HISTORY_MAX_CHARS=24000
BIGQUERY_MAX_BYTES=1000000000
# OpenRouter only; Gemini selects published rates by model ID.
INPUT_USD_PER_MILLION=10
OUTPUT_USD_PER_MILLION=40
